# Salin ke .env lalu isi. JANGAN commit .env.
NODE_ENV=production
PORT=3000
# Prisma: batasi koneksi (Postgres STB max_connections=20)
DATABASE_URL=postgresql://perumbca:PASSWORD@postgres:5432/perumbca?connection_limit=5
# openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://192.168.15.35:3000
APP_NAME=Iuran Bumi Cikarang Asri
# true bila sudah lewat HTTPS (Traefik/Cloudflare)
COOKIE_SECURE=false
TRUST_PROXY=loopback
# Dibuat sekali saat seed bila belum ada Super Admin; hapus password setelah login pertama
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_NAMA=Super Admin
# Midtrans (kosong = nonaktif). Sandbox dulu.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
# none = kirim manual via wa.me, baileys = otomatis
WA_PROVIDER=none
CRON_ENABLED=true
