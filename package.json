{
  "name": "perumbca",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Informasi Iuran Perumahan Bumi Cikarang Asri",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "import:csv": "node src/modules/impor/cli.js",
    "test": "node --test --test-concurrency=1 tests/keuangan.test.js tests/integrasi.test.js tests/http.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "17.2.3",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "node-cron": "4.2.1",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "zod": "4.1.12"
  },
  "optionalDependencies": {
    "baileys": "6.7.23",
    "qrcode-terminal": "0.12.0"
  }
}
