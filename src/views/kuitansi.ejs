<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title><%= title %></title>
<link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/static/css/app.css"></head>
<body class="bg-white">
<div class="container py-4" style="max-width:640px">
  <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-3">
    <div><h1 class="h5 m-0">KUITANSI PEMBAYARAN IURAN</h1><div class="small text-muted"><%= s.nama_perumahan %></div></div>
    <div class="text-end small"><b><%= p.nomor %></b><br><%= u.waktu(p.tanggal) %></div>
  </div>
  <table class="table table-sm"><tbody>
    <tr><th style="width:35%">Rumah</th><td><%= p.rumah.kode %></td></tr>
    <tr><th>Metode</th><td><%= p.metode %></td></tr>
    <tr><th>Jumlah</th><td class="fw-bold money"><%= u.rupiah(p.nominal) %></td></tr>
  </tbody></table>
  <h2 class="h6">Rincian</h2>
  <table class="table table-sm small"><thead><tr><th>Periode</th><th>Komponen</th><th class="text-end">Nominal</th></tr></thead><tbody>
    <% p.alokasi.forEach(a => { %><tr><td><%= u.periodeLabel(a.tagihanItem.tagihan.periode) %></td><td><%= a.tagihanItem.nama %></td><td class="text-end money"><%= u.rupiah(a.nominal) %></td></tr><% }) %>
  </tbody></table>
  <p class="small text-muted">Kuitansi ini dibuat otomatis oleh sistem dan sah tanpa tanda tangan.</p>
  <button class="btn btn-outline-secondary btn-sm no-print" data-print>Cetak</button>
</div>
<script src="/static/js/print.js"></script>
</body></html>
