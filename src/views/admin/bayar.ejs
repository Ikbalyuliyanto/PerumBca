<%- include('../partials/head') %>
<% const legenda = jenis.map((j, i) => `${i + 1}. ${j.nama} ${u.rupiah(j.nominal)}`).join(' · '); %>
<div class="page-head">
  <div><h1>Bayar Iuran</h1>
    <div class="sub">✓ lunas · ✗ belum
      <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="popover" data-bs-trigger="focus" data-bs-placement="bottom" title="Urutan jenis iuran" data-bs-content="<%= legenda %>"><i class="bi bi-info-circle"></i> keterangan</button></div></div>
  <div class="month-nav"><a href="?periode=<%= prev %>"><i class="bi bi-chevron-left"></i></a><span><%= u.periodeLabel(periode) %></span><a href="?periode=<%= next %>"><i class="bi bi-chevron-right"></i></a></div>
</div>

<div class="row g-2 mb-3">
  <div class="col-4"><div class="card stat py-2 px-3"><div><div class="val"><%= ring.total %></div><div class="lbl">Wajib bayar</div></div></div></div>
  <div class="col-4"><div class="card stat py-2 px-3"><div><div class="val text-success"><%= ring.lunas %></div><div class="lbl">Lunas</div></div></div></div>
  <div class="col-4"><div class="card stat py-2 px-3"><div><div class="val money text-danger fs-6"><%= u.rupiah(ring.sisa) %></div><div class="lbl">Belum masuk</div></div></div></div>
</div>

<form method="get" class="d-flex flex-wrap gap-2 justify-content-between mb-3">
  <input type="hidden" name="periode" value="<%= periode %>">
  <div class="d-flex gap-2">
    <a href="?periode=<%= periode %>" class="btn btn-sm <%= !query.f ? 'btn-brand' : 'btn-light' %>">Semua</a>
    <a href="?periode=<%= periode %>&f=belum" class="btn btn-sm <%= query.f === 'belum' ? 'btn-brand' : 'btn-light' %>">Belum</a>
    <a href="?periode=<%= periode %>&f=lunas" class="btn btn-sm <%= query.f === 'lunas' ? 'btn-brand' : 'btn-light' %>">Lunas</a>
  </div>
  <div class="input-group input-group-sm" style="max-width:220px"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input name="q" value="<%= query.q || '' %>" class="form-control" placeholder="Cari rumah / nama"><% if (query.f) { %><input type="hidden" name="f" value="<%= query.f %>"><% } %></div>
</form>

<form method="post" action="/admin/bayar/semua" id="bulk-form" data-confirm="Lunaskan semua iuran <%= u.periodeLabel(periode) %> untuk rumah yang dicentang?">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="periode" value="<%= periode %>">
  <div class="row g-2">
  <% list.forEach(r => { const lunas = !r.bebas && r.sisa === 0; const bisa = !r.bebas && !lunas && can('pembayaran.input'); %>
    <div class="col-md-6">
      <div class="card house-card <%= r.bebas ? 'opacity-50' : '' %>">
        <% if (bisa) { %><input type="checkbox" class="form-check-input house-chk" name="rumah" value="<%= r.id %>" aria-label="Pilih <%= r.kode %>"><% } %>
        <div class="flex-grow-1 min-w-0">
          <div class="d-flex align-items-baseline gap-2"><span class="house"><%= r.kode %></span><span class="small text-muted text-truncate"><%= r.nama || '—' %></span></div>
          <div class="d-flex gap-1 mt-1">
            <% jenis.forEach((j, i) => { const s = r.per[j.kode]; %>
              <span class="mark mark-<%= s %>" tabindex="0" data-bs-toggle="tooltip" title="<%= j.nama %> <%= u.rupiah(j.nominal) %>: <%= {LUNAS:'lunas',BELUM:'belum',SEBAGIAN:'sebagian',BEBAS:'tidak wajib'}[s] %>"><%= s === 'LUNAS' ? '✓' : s === 'BEBAS' ? '–' : '✗' %></span>
            <% }) %>
          </div>
        </div>
        <div class="text-end">
          <div class="small fw-semibold money <%= lunas ? 'text-success' : 'text-danger' %>"><%= r.bebas ? 'bebas' : lunas ? 'Lunas' : u.rupiah(r.sisa) %></div>
          <div class="d-flex gap-1 mt-1 justify-content-end">
            <% if (bisa) { %><button class="btn btn-sm btn-brand py-0" form="one-<%= r.id %>" title="Bayar semua"><i class="bi bi-check2-all"></i> Bayar</button><% } %>
            <a class="btn btn-sm btn-light py-0" href="/admin/bayar/<%= r.id %>" title="Pilih iuran tertentu"><i class="bi bi-three-dots"></i></a>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (!list.length) { %><div class="col-12 text-center text-muted py-4">Tidak ada data.</div><% } %>
  </div>
  <% if (can('pembayaran.input') && list.some(r => !r.bebas && r.sisa > 0)) { %>
  <div class="card sticky-bar mt-3">
    <label class="small"><input type="checkbox" class="form-check-input" data-check-all="rumah"> Pilih semua yang belum</label>
    <div class="d-flex gap-2 align-items-center"><input type="date" name="tanggal" class="form-control form-control-sm" value="<%= new Date().toISOString().slice(0,10) %>" style="width:auto"><button class="btn btn-brand btn-sm"><i class="bi bi-check2-all"></i> Lunaskan yang dicentang</button></div>
  </div>
  <% } %>
</form>
<% list.forEach(r => { if (!r.bebas && r.sisa > 0) { %><form id="one-<%= r.id %>" method="post" action="/admin/bayar/semua" class="d-none" data-confirm="Bayar semua iuran <%= r.kode %> <%= u.periodeLabel(periode) %> (<%= u.rupiah(r.sisa) %>)?"><%- include('../partials/csrf') %><input type="hidden" name="periode" value="<%= periode %>"><input type="hidden" name="rumah" value="<%= r.id %>"></form><% } }) %>
<%- include('../partials/foot') %>
