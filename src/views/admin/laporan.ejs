<%- include('../partials/head') %>
<% const T = rekap.reduce((a, d) => ({ sa: a.sa + d.saldoAwal, m: a.m + d.masuk, k: a.k + d.keluar, s: a.s + d.saldoAkhir }), { sa: 0, m: 0, k: 0, s: 0 });
   const JN = {SALDO_AWAL:'Saldo awal',IURAN:'Iuran',PENGELUARAN:'Pengeluaran',BIAYA_MIDTRANS:'Biaya online',PEMBALIK:'Koreksi',LAINNYA:'Lain-lain'}; %>
<div class="page-head">
  <div><h1>Laporan</h1><div class="sub"><%= u.periodeLabel(dariP) %> – <%= u.periodeLabel(sampaiP) %></div></div>
  <div class="no-print d-flex gap-2">
    <a class="btn btn-light" href="?<%= new URLSearchParams({ ...query, format: 'csv' }).toString() %>"><i class="bi bi-download"></i> Excel/CSV</a>
    <button class="btn btn-light" data-print><i class="bi bi-printer"></i> Cetak</button>
  </div>
</div>

<form class="card mb-3 no-print" method="get"><div class="card-body row g-2 align-items-end">
  <div class="col-6 col-md-2"><label class="form-label small">Dari</label><input type="month" name="dari" value="<%= dariP %>" class="form-control form-control-sm"></div>
  <div class="col-6 col-md-2"><label class="form-label small">Sampai</label><input type="month" name="sampai" value="<%= sampaiP %>" class="form-control form-control-sm"></div>
  <div class="col-6 col-md-2"><label class="form-label small">Dana</label><select name="dana" class="form-select form-select-sm"><option value="">Semua</option><% dana.forEach(d => { %><option value="<%= d.id %>" <%= query.dana == d.id ? 'selected' : '' %>><%= d.nama %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label small">Jenis</label><select name="jenis" class="form-select form-select-sm"><option value="">Semua</option><% Object.entries(JN).forEach(([k, l]) => { %><option value="<%= k %>" <%= query.jenis === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
  <div class="col-6 col-md-1"><label class="form-label small">Blok</label><select name="blok" class="form-select form-select-sm"><option value="">Semua</option><% bloks.forEach(b => { %><option <%= query.blok === b.kode ? 'selected' : '' %>><%= b.kode %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label small">Rumah</label><input name="rumah" value="<%= query.rumah || '' %>" class="form-control form-control-sm" placeholder="mis. B12A"></div>
  <div class="col-md-1"><button class="btn btn-sm btn-brand w-100">Tampilkan</button></div>
</div></form>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="card stat"><div class="ico ico-blue"><i class="bi bi-flag"></i></div><div><div class="val money"><%= u.rupiah(T.sa) %></div><div class="lbl">Saldo awal periode</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat"><div class="ico ico-green"><i class="bi bi-arrow-down-circle"></i></div><div><div class="val money"><%= u.rupiah(T.m) %></div><div class="lbl">Pemasukan</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat"><div class="ico ico-red"><i class="bi bi-arrow-up-circle"></i></div><div><div class="val money"><%= u.rupiah(T.k) %></div><div class="lbl">Pengeluaran</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat"><div class="ico ico-violet"><i class="bi bi-safe"></i></div><div><div class="val money"><%= u.rupiah(T.s) %></div><div class="lbl">Saldo akhir</div></div></div></div>
</div>

<div class="card mb-3"><div class="card-head"><h2>Per dana</h2></div>
<div class="table-responsive"><table class="table align-middle">
  <thead><tr><th>Dana</th><th class="text-end">Saldo awal</th><th class="text-end">Masuk</th><th class="text-end">Keluar</th><th class="text-end">Saldo akhir</th></tr></thead><tbody>
  <% rekap.forEach(d => { %><tr><td><%= d.nama %></td><td class="text-end money"><%= u.rupiah(d.saldoAwal) %></td><td class="text-end money text-success"><%= u.rupiah(d.masuk) %></td><td class="text-end money text-danger"><%= u.rupiah(d.keluar) %></td><td class="text-end money fw-semibold"><%= u.rupiah(d.saldoAkhir) %></td></tr><% }) %>
</tbody></table></div>
<% if (query.dana || query.jenis) { %><div class="card-body small text-warning py-2">Filter dana/jenis aktif: angka hanya menghitung transaksi yang sesuai filter.</div><% } %>
</div>

<div class="card mb-3"><div class="card-head"><h2>Iuran per rumah</h2></div>
<div class="table-responsive"><table class="table align-middle">
  <thead><tr><th>Rumah</th><th class="text-end">Bulan</th><th class="text-end">Tagihan</th><th class="text-end">Dibayar</th><th class="text-end">Sisa</th></tr></thead><tbody>
  <% rumahRekap.forEach(r => { %><tr><td class="house"><%= r.kode %></td><td class="text-end"><%= r.bulan %><% if (r.belum) { %> <span class="text-danger small">(<%= r.belum %> belum)</span><% } %></td><td class="text-end money"><%= u.rupiah(r.total) %></td><td class="text-end money"><%= u.rupiah(r.terbayar) %></td><td class="text-end money <%= r.total - r.terbayar ? 'text-danger fw-semibold' : 'text-muted' %>"><%= u.rupiah(r.total - r.terbayar) %></td></tr><% }) %>
  <% if (!rumahRekap.length) { %><tr><td colspan="5" class="text-center text-muted py-3">Tidak ada tagihan pada periode ini.</td></tr><% } %>
</tbody></table></div></div>

<div class="card"><div class="card-head"><h2>Rincian transaksi (<%= entries.length %>)</h2></div>
<div class="table-responsive"><table class="table table-sm align-middle">
  <thead><tr><th>Tanggal</th><th>Keterangan</th><th>Dana</th><th class="text-end">Masuk</th><th class="text-end">Keluar</th></tr></thead><tbody>
  <% entries.forEach(e => { %><tr><td class="small text-nowrap"><%= u.tanggal(e.tanggal) %></td><td><%= e.keterangan %> <span class="small text-muted">· <%= JN[e.jenis] || e.jenis %></span></td><td class="small"><%= e.dana.nama %></td><td class="text-end money"><%= e.arah === 'MASUK' ? u.rupiah(e.nominal) : '' %></td><td class="text-end money"><%= e.arah === 'KELUAR' ? u.rupiah(e.nominal) : '' %></td></tr><% }) %>
</tbody></table></div></div>
<script src="/static/js/print.js"></script>
<%- include('../partials/foot') %>
