<%- include('../partials/head') %>
<% const hitung = (k) => list.filter(r => r.kondisi === k).length; %>
<div class="page-head">
  <div><h1>Data Warga</h1><div class="sub"><%= list.length %> rumah<% if (query.q || query.blok || query.kondisi || query.verifikasi) { %> (difilter)<% } %></div></div>
  <% if (user.isSuperAdmin) { %><a href="/admin/rumah/baru" class="btn btn-brand"><i class="bi bi-plus-lg"></i> Tambah rumah</a><% } %>
</div>

<div class="card">
  <form method="get" class="card-head flex-wrap">
    <div class="d-flex gap-2 flex-wrap">
      <% [['', 'Semua'], ['AKTIF', 'Ada penghuni'], ['KOSONG', 'Kosong'], ['TIDAK_DITEMPATI', 'Tidak ditempati'], ['PIHAK_KEDUA', 'Pihak kedua']].forEach(([k, l]) => { %>
        <a href="?kondisi=<%= k %><%= query.blok ? '&blok=' + query.blok : '' %>" class="btn btn-sm <%= (query.kondisi || '') === k ? 'btn-brand' : 'btn-light' %>"><%= l %></a>
      <% }) %>
      <a href="?verifikasi=PERLU_VERIFIKASI" class="btn btn-sm <%= query.verifikasi ? 'btn-danger' : 'btn-outline-danger' %>"><i class="bi bi-exclamation-triangle"></i> Perlu dicek</a>
    </div>
    <div class="d-flex gap-2">
      <select name="blok" class="form-select form-select-sm" style="width:auto"><option value="">Semua blok</option><% bloks.forEach(b => { %><option <%= query.blok === b.kode ? 'selected' : '' %>><%= b.kode %></option><% }) %></select>
      <div class="input-group input-group-sm" style="max-width:220px"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input name="q" value="<%= query.q || '' %>" class="form-control" placeholder="Cari rumah / nama"></div>
      <button class="btn btn-sm btn-light">Cari</button>
    </div>
  </form>
  <div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead><tr><th>Rumah</th><th>Penghuni</th><th class="d-none d-md-table-cell">Status</th><th class="text-end">Tunggakan</th><th class="text-end" style="width:170px"></th></tr></thead>
    <tbody>
    <% list.forEach(r => { const p = r.penghunian[0]; %>
      <tr>
        <td><a href="/admin/rumah/<%= r.id %>" class="house text-reset"><%= r.kode %></a><% if (r.verifikasi === 'PERLU_VERIFIKASI') { %> <i class="bi bi-exclamation-triangle-fill text-danger" title="Perlu dicek"></i><% } %></td>
        <td><div><%= p ? p.nama : '—' %></div><div class="small text-muted"><% if (p && p.noWa) { %><i class="bi bi-whatsapp text-success"></i> <%= p.noWa %><% } else { %>tanpa WA<% } %></div></td>
        <td class="d-none d-md-table-cell"><span class="badge kondisi-<%= r.kondisi %>"><%= {AKTIF:'Ada penghuni',KOSONG:'Kosong',TIDAK_DITEMPATI:'Tidak ditempati',PIHAK_KEDUA:'Pihak kedua'}[r.kondisi] %></span></td>
        <td class="text-end money <%= r.tunggakan.sisa ? 'text-danger fw-semibold' : 'text-muted' %>"><%= r.tunggakan.sisa ? u.rupiah(r.tunggakan.sisa) : '—' %><% if (r.tunggakan.bulan) { %><div class="small fw-normal"><%= r.tunggakan.bulan %> bulan</div><% } %></td>
        <td class="text-end text-nowrap">
          <% if (can('pembayaran.input')) { %><a href="/admin/bayar/<%= r.id %>" class="btn btn-sm btn-light"><i class="bi bi-cash-coin"></i> Bayar</a><% } %>
          <a href="/admin/rumah/<%= r.id %>" class="btn btn-sm btn-light">Detail</a>
        </td>
      </tr>
    <% }) %>
    <% if (!list.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Tidak ada data.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/foot') %>
