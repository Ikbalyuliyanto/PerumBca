<%- include('../partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-2">
  <h1 class="h4 m-0">Data rumah <span class="text-muted fs-6">(<%= list.length %>)</span></h1>
  <% if (user.isSuperAdmin) { %><a href="/admin/rumah/baru" class="btn btn-sm btn-brand"><i class="bi bi-plus"></i> Rumah</a><% } %>
</div>
<form class="row g-2 mb-3" method="get">
  <div class="col-6 col-md-2"><select name="blok" class="form-select form-select-sm"><option value="">Semua blok</option><% bloks.forEach(b => { %><option <%= query.blok === b.kode ? 'selected' : '' %>><%= b.kode %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><select name="kondisi" class="form-select form-select-sm"><option value="">Semua status</option><% ['AKTIF','KOSONG','TIDAK_DITEMPATI','PIHAK_KEDUA'].forEach(k => { %><option <%= query.kondisi === k ? 'selected' : '' %>><%= k %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><select name="verifikasi" class="form-select form-select-sm"><option value="">Semua data</option><option value="PERLU_VERIFIKASI" <%= query.verifikasi ? 'selected' : '' %>>Perlu verifikasi</option></select></div>
  <div class="col-6 col-md-3"><input name="q" value="<%= query.q || '' %>" class="form-control form-control-sm" placeholder="Cari kode / nama"></div>
  <div class="col-md-1"><button class="btn btn-sm btn-outline-secondary w-100">Filter</button></div>
</form>
<div class="card"><div class="table-responsive">
<table class="table table-sm table-hover m-0">
  <thead><tr><th>No</th><th>Rumah</th><th>Penghuni</th><th>Status</th><th class="text-end">Tunggakan</th><th></th></tr></thead>
  <tbody>
  <% list.forEach(r => { const p = r.penghunian[0]; %>
    <tr>
      <td class="text-muted small"><%= r.noUrutSumber || '' %></td>
      <td><a href="/admin/rumah/<%= r.id %>" class="fw-semibold"><%= r.kode %></a><% if (!r.aktif) { %> <span class="badge text-bg-secondary">nonaktif</span><% } %></td>
      <td><%= p ? p.nama : '—' %><% if (p && p.noWa) { %> <i class="bi bi-whatsapp text-success small"></i><% } %></td>
      <td><span class="badge kondisi-<%= r.kondisi %>"><%= r.kondisi.replace('_', ' ') %></span></td>
      <td class="text-end money <%= r.tunggakan.sisa ? 'text-danger' : '' %>"><%= r.tunggakan.sisa ? u.rupiah(r.tunggakan.sisa) + ' (' + r.tunggakan.bulan + ' bln)' : '—' %></td>
      <td><% if (r.verifikasi === 'PERLU_VERIFIKASI') { %><span class="badge text-bg-danger">PERLU VERIFIKASI</span><% } %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div></div>
<%- include('../partials/foot') %>
