<%- include('../partials/head') %>
<div class="row justify-content-center"><div class="col-md-5">
  <div class="card p-4">
    <h1 class="h5">Ganti password</h1>
    <form method="post">
      <%- include('../partials/csrf') %>
      <div class="mb-2"><label class="form-label">Password lama</label><input type="password" name="lama" class="form-control" required autocomplete="current-password"></div>
      <div class="mb-2"><label class="form-label">Password baru (min. 10 karakter)</label><input type="password" name="baru" minlength="10" class="form-control" required autocomplete="new-password"></div>
      <div class="mb-3"><label class="form-label">Ulangi password baru</label><input type="password" name="ulang" minlength="10" class="form-control" required autocomplete="new-password"></div>
      <button class="btn btn-brand">Simpan</button>
    </form>
  </div>
</div></div>
<%- include('../partials/foot') %>
