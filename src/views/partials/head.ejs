<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" type="image/svg+xml" href="/static/dasher/img/logo-icon.svg">
  <script src="/static/dasher/js/color-modes.js"></script>
  <script src="/static/dasher/js/sidebar-init.js"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/static/dasher/css/simplebar.min.css">
  <link rel="stylesheet" href="/static/dasher/css/tabler-icons.min.css">
  <link rel="stylesheet" href="/vendor/icons/bootstrap-icons.min.css">
  <%# Tema: Dasher (MIT, Codescandy) — lihat /static/dasher/LICENSE-dasher.txt %>
  <link rel="stylesheet" href="/static/dasher/css/theme.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<% const staffNav = locals.user && locals.isStaff;
   const isOn = (href) => href === '/admin' ? (path === '/admin' || path === '/admin/') : path.startsWith(href);
   const menu = [
    [null, 'Menu'],
    ['dashboard.lihat', '/admin', 'ti-layout-dashboard', 'Dashboard'],
    ['pembayaran.input', '/admin/bayar', 'ti-cash', 'Bayar Iuran'],
    ['rumah.lihat', '/admin/rumah', 'ti-users', 'Data Warga'],
    ['kebijakan.lihat', '/admin/jenis-iuran', 'ti-tags', 'Jenis Iuran'],
    [null, 'Keuangan'],
    ['pengeluaran.lihat', '/admin/pengeluaran', 'ti-wallet', 'Pengeluaran'],
    ['ledger.lihat', '/admin/ledger', 'ti-notebook', 'Buku Kas'],
    ['laporan.lihat', '/admin/laporan', 'ti-chart-bar', 'Laporan'],
    [null, 'Lainnya'],
    ['pembayaran.lihat', '/admin/pembayaran', 'ti-receipt', 'Riwayat Bayar'],
    ['tagihan.lihat', '/admin/tagihan', 'ti-file-invoice', 'Tagihan'],
    ['pengajuan.putuskan', '/admin/pengajuan', 'ti-inbox', 'Pengajuan Warga'],
    ['impor.kelola', '/admin/impor', 'ti-upload', 'Impor & Verifikasi'],
    ['wa.kelola', '/admin/wa', 'ti-brand-whatsapp', 'WhatsApp'],
    ['user.kelola', '/admin/users', 'ti-user-cog', 'Akun'],
    ['*super', '/admin/roles', 'ti-shield-lock', 'Hak Akses'],
    ['*super', '/admin/pengaturan', 'ti-settings', 'Pengaturan'],
    ['audit.lihat', '/admin/audit', 'ti-history', 'Audit Log'],
  ];
   const navItems = () => menu.filter(m => {
     if (m[0] === null) return true;
     return m[0] === '*super' ? user.isSuperAdmin : can(m[0]);
   }); %>
<body>
<% if (staffNav) { %>
<div>
  <%# ── Sidebar desktop ── %>
  <div id="miniSidebar">
    <div class="brand-logo">
      <a class="d-none d-md-flex align-items-center gap-2" href="/admin">
        <img src="/static/dasher/img/logo-icon.svg" alt="">
        <span class="fw-bold fs-4 site-logo-text">Iuran BCA</span>
      </a>
    </div>
    <ul class="navbar-nav flex-column">
      <% navItems().forEach(m => { if (m[0] === null) { %>
        <li class="nav-item"><div class="nav-heading"><%= m[1] %></div><hr class="mx-5 nav-line mb-1"></li>
      <% } else { %>
        <li class="nav-item"><a class="nav-link <%= isOn(m[1]) ? 'active' : '' %>" href="<%= m[1] %>"><span class="nav-icon"><i class="ti <%= m[2] %> fs-4"></i></span> <span class="text"><%= m[3] %></span></a></li>
      <% } }) %>
    </ul>
  </div>

  <%# ── Konten ── %>
  <div id="content" class="position-relative h-100">
    <div class="navbar-glass navbar navbar-expand-lg px-0 px-lg-4">
      <div class="container-fluid px-lg-0">
        <div class="d-flex align-items-center gap-4">
          <div class="d-block d-lg-none"><a class="text-inherit" data-bs-toggle="offcanvas" href="#offcanvasNav" role="button" aria-label="Menu"><i class="ti ti-menu-2 fs-3"></i></a></div>
          <div class="d-none d-lg-block">
            <a class="sidebar-toggle d-flex p-3" role="button" tabindex="0" style="cursor:pointer" aria-label="Ciutkan menu">
              <span class="collapse-mini"><i class="ti ti-layout-sidebar-left-collapse fs-4 text-secondary"></i></span>
              <span class="collapse-expanded"><i class="ti ti-layout-sidebar-left-expand fs-4 text-secondary"></i></span>
            </a>
          </div>
          <span class="fw-semibold d-lg-none"><%= title %></span>
        </div>
        <ul class="list-unstyled d-flex align-items-center mb-0 gap-2">
          <li>
            <div class="dropdown">
              <button class="btn btn-ghost btn-icon rounded-circle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-label="Ganti tema">
                <i class="ti theme-icon-active lh-1 fs-5"><i class="ti theme-icon ti-sun"></i></i>
                <span class="visually-hidden bs-theme-text">Tema</span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="light"><i class="ti theme-icon ti-sun"></i><span class="ms-2">Terang</span></button></li>
                <li><button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark"><i class="ti theme-icon ti-moon-stars"></i><span class="ms-2">Gelap</span></button></li>
                <li><button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="auto"><i class="ti theme-icon ti-circle-half-2"></i><span class="ms-2">Otomatis</span></button></li>
              </ul>
            </div>
          </li>
          <li class="dropdown">
            <a href="#" data-bs-toggle="dropdown" class="d-flex align-items-center gap-2 text-reset">
              <span class="avatar avatar-sm rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center fw-bold"><%= user.nama.slice(0,1).toUpperCase() %></span>
            </a>
            <div class="dropdown-menu dropdown-menu-end p-0" style="min-width:220px">
              <div class="px-4 py-3 border-bottom"><div class="fw-semibold"><%= user.nama %></div><div class="small text-secondary">@<%= user.username %><% if (user.isSuperAdmin) { %> · Super Admin<% } %></div></div>
              <div class="p-2">
                <a class="dropdown-item" href="/akun/password"><i class="ti ti-key me-2"></i>Ganti password</a>
                <form method="post" action="/logout" class="m-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="dropdown-item text-danger"><i class="ti ti-logout me-2"></i>Keluar</button></form>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
    <div class="custom-container">
<% } else { %>
  <div class="container py-4" style="max-width:960px">
    <a class="d-flex align-items-center gap-2 mb-4 text-reset" href="/"><img src="/static/dasher/img/logo-icon.svg" alt=""><span class="fw-bold fs-4">Iuran BCA</span></a>
<% } %>
<% if (locals.flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert"><%= flash.msg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
